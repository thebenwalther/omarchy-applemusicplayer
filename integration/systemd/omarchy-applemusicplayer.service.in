[Unit]
Description=Omarchy Apple Music Player service
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@BUN@ run @REPO@/src/server.ts
Restart=on-failure
RestartSec=2
Environment=OMARCHY_APPLEMUSIC_PORT=17689

[Install]
WantedBy=default.target
