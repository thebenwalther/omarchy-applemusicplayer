#!/usr/bin/env bash
set -euo pipefail

APP_URL="http://mini.applemusic.localhost:17689/mini"
PROFILE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-applemusicplayer/chromium-mini"
WINDOW_CLASS="chrome-mini.applemusic.localhost__mini-Default"

systemctl --user start omarchy-applemusicplayer.service
for _ in {1..40}; do
  curl --silent --fail --max-time 1 "http://127.0.0.1:17689/api/health" >/dev/null 2>&1 && break
  sleep 0.1
done

WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg c "$WINDOW_CLASS" '.[] | select(.class == $c) | .address' | head -n1)
if [[ -z $WINDOW_ADDRESS ]]; then
  mkdir -p "$PROFILE_DIR"
  setsid uwsm-app -- chromium --app="$APP_URL" --user-data-dir="$PROFILE_DIR" --no-first-run --disable-session-crashed-bubble >/dev/null 2>&1 &
  for _ in {1..50}; do
    WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg c "$WINDOW_CLASS" '.[] | select(.class == $c) | .address' | head -n1)
    [[ -n $WINDOW_ADDRESS ]] && break
    sleep 0.1
  done
fi

hyprctl dispatch 'hl.dsp.workspace.toggle_special("applemusic")' >/dev/null
